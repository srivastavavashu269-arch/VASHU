# Copy to .env.local for local work. NEVER commit real values.
# On Vercel set these under Project > Settings > Environment Variables.
# Level 1 (demo mode) needs NONE of these to build or run.

# --- App ---
# demo | live
APP_MODE=demo
# Local: http://localhost:3000 ; Vercel: your production URL, e.g. https://your-app.vercel.app
APP_BASE_URL=http://localhost:3000

# --- Database (Level 2, Supabase-compatible Postgres) ---
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (Level 2) ---
# mock | nvidia-nim
AI_PROVIDER=mock
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_API_KEY=
AI_CHAT_MODEL=
AI_EMBEDDING_MODEL=

# --- Encryption for stored channel tokens (Level 3) ---
# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Channels (Level 3) ---
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
